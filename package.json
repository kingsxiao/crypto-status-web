{
  "name": "crypto-status",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @repo/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @repo/web",
    "ios:export": "npm run export --workspace @repo/ios"
  },
  "devDependencies": {
    "eslint": "^10.10.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.4",
    "react-native-reanimated": "4.5.1",
    "react-native-gesture-handler": "2.32.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0"
  }
}
